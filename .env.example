# =====================================================
# Karmic Ascension Platform — Environment Variables
# =====================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# NEXT_PUBLIC_* variables are exposed to the browser — do NOT put secrets in them.

# -----------------------------------------------
# MANDATORY — Primary Supabase Project (DB1 / Main / Customer)
# -----------------------------------------------

# Your Supabase project URL (from Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase publishable/anon key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Supabase service-role key — SERVER ONLY, never in NEXT_PUBLIC_
# Used for admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------
# MANDATORY — Canonical Application Origin
# -----------------------------------------------

# The full public URL of this deployment (used for auth callbacks, redirects)
# Include protocol and no trailing slash. Example: https://jyotishsetu.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# -----------------------------------------------
# OPTIONAL — Secondary Supabase Project (DB2 / Admin)
# Leave empty to use DB1 for both customer and admin operations.
# Configure a separate admin Supabase project for enhanced isolation.
# -----------------------------------------------

# Admin Supabase project URL
ADMIN_SUPABASE_URL=https://your-admin-project-id.supabase.co

# Admin publishable/anon key (safe to expose to browser for admin dashboard client)
ADMIN_SUPABASE_PUBLISHABLE_KEY=your-admin-supabase-anon-key

# Admin service-role key — SERVER ONLY, never in NEXT_PUBLIC_
ADMIN_SUPABASE_SERVICE_ROLE_KEY=your-admin-supabase-service-role-key

# -----------------------------------------------
# OPTIONAL — Service-role key aliases per database
# Use these if you need separate service-role keys for DB1 and DB2
# DB1_SUPABASE_SERVICE_ROLE_KEY takes precedence over SUPABASE_SERVICE_ROLE_KEY for DB1 operations
# -----------------------------------------------
# DB1_SUPABASE_SERVICE_ROLE_KEY=your-db1-service-role-key

# -----------------------------------------------
# OPTIONAL — Rate Limiting (Distributed)
# For single-instance deployments: leave empty (uses in-memory store)
# For multi-instance/serverless deployments: configure Upstash Redis
# -----------------------------------------------
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# -----------------------------------------------
# OPTIONAL — Email / SMTP
# Supabase Auth handles transactional email by default.
# Configure only if you use a custom SMTP relay.
# -----------------------------------------------
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=noreply@your-domain.com
# SMTP_FROM_NAME=Karmic Ascension

# -----------------------------------------------
# In-House Video Consultation Configuration
# In-House WebRTC SFU engine powered by LiveKit Cloud
# -----------------------------------------------
NEXT_PUBLIC_CONSULTATION_PROVIDER=inhouse
NEXT_PUBLIC_LIVEKIT_URL=wss://astrosetu-3dx4gffs.livekit.cloud
LIVEKIT_URL=wss://astrosetu-3dx4gffs.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# -----------------------------------------------
# OPTIONAL — Google Gemini AI Integration (Customer & Astrologer Support)
# When not provided, platform support operates in grounded deterministic mode
# -----------------------------------------------
# GEMINI_API_KEY=your-google-genai-api-key
# GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------
# OPTIONAL / FEATURE: Google OAuth Authentication
# Handled natively by Supabase Auth (DB1)
# -----------------------------------------------
# In Google Cloud Console (APIs & Services -> Credentials -> OAuth 2.0 Client IDs):
#   - Authorized JavaScript Origins:
#       Local:      http://localhost:3000
#       Production: https://astrologer-platform.vercel.app
#   - Authorized Redirect URIs (Supabase Auth callback URL):
#       https://<your-supabase-project-id>.supabase.co/auth/v1/callback
#
# In Supabase Dashboard (Authentication -> Providers -> Google):
#   - Enable Google provider: ON
#   - Client ID:     <YOUR_GOOGLE_CLIENT_ID> (from Google Cloud Console)
#   - Client Secret: <YOUR_GOOGLE_CLIENT_SECRET> (from Google Cloud Console)
#   - Authorized Redirect URLs (Authentication -> URL Configuration):
#       http://localhost:3000/auth/callback
#       https://astrologer-platform.vercel.app/auth/callback
#
# Server-side environment variables (optional/reference):
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------
# OPTIONAL / FEATURE: Ola Maps Web SDK & Autocomplete API (Krutrim Cloud)
# Obtain from: https://cloud.olakrutrim.com/console/maps?section=credentials
# Default standard map style: https://api.olamaps.io/tiles/vector/v1/styles/default-light-standard/style.json
# -----------------------------------------------
# OLA_MAPS_API_KEY=your_actual_api_key_here
# NEXT_PUBLIC_OLA_MAPS_API_KEY=your_actual_public_client_key_here
# NEXT_PUBLIC_OLA_MAPS_STYLE_URL=https://api.olamaps.io/tiles/vector/v1/styles/default-light-standard/style.json

# -----------------------------------------------
# DEPLOYMENT NOTES
# -----------------------------------------------
# 1. Local dev:   Copy to .env.local, fill DB1 variables.
# 2. CI/CD:       Set as encrypted environment secrets. Never set secrets in plain text.
# 3. Staging:     Use a separate Supabase project from production.
# 4. Production:  Rotate service-role keys immediately if accidentally committed.



# -----------------------------------------------
# Karmic Ascension Pay (Indigenous Payment Gateway Configuration)
# -----------------------------------------------
JYOTISH_PAY_MODE=sandbox
JYOTISH_PAY_VPA=your_merchant_vpa@upi
JYOTISH_PAY_MERCHANT_NAME=Karmic Ascension Astrology Services
JYOTISH_PAY_MCC=8299
JYOTISH_PAY_WEBHOOK_SECRET=your_webhook_secret_key
JYOTISH_PAY_WEBHOOK_URL=https://astrosettu.netlify.app/api/pay/webhook/gateway

